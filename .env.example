# DevGuide AI API local-development configuration (safe examples only)
DEVGUIDE_APP_VERSION=0.1.0
DEVGUIDE_ENVIRONMENT=local
DEVGUIDE_LOG_LEVEL=INFO
DEVGUIDE_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
DEVGUIDE_DATABASE_URL=postgresql+asyncpg://devguide:devguide@localhost:5432/devguide
DEVGUIDE_DATABASE_POOL_SIZE=5
DEVGUIDE_DATABASE_POOL_TIMEOUT_SECONDS=5
DEVGUIDE_ANALYSIS_PIPELINE_VERSION=1
DEVGUIDE_REDIS_URL=redis://localhost:6379/0
DEVGUIDE_AUTH_COOKIE_NAME=devguide_session
DEVGUIDE_AUTH_SESSION_HOURS=168
# Use true in HTTPS production deployments.
DEVGUIDE_AUTH_COOKIE_SECURE=false
DEVGUIDE_QUEUE_NAME=devguide-analysis
DEVGUIDE_WORKER_CONCURRENCY=4
DEVGUIDE_WORKER_JOB_TIMEOUT_SECONDS=300
DEVGUIDE_WORKER_RETRY_COUNT=3
DEVGUIDE_WORKER_RETRY_DELAY_SECONDS=5
DEVGUIDE_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
DEVGUIDE_CLONE_TIMEOUT_SECONDS=60
DEVGUIDE_MAXIMUM_REPOSITORY_SIZE_MB=100
DEVGUIDE_MAXIMUM_REPOSITORY_FILE_COUNT=20000
DEVGUIDE_MAXIMUM_INDIVIDUAL_FILE_SIZE_MB=5
DEVGUIDE_TEMPORARY_WORKSPACE_ROOT=C:/tmp/devguide-workspaces
DEVGUIDE_GIT_EXECUTABLE=git
DEVGUIDE_CLONE_DEPTH=1
DEVGUIDE_FINDINGS_LARGE_FILE_LINE_THRESHOLD=1000
DEVGUIDE_MAXIMUM_FINDINGS_PER_ANALYSIS=2000
DEVGUIDE_MAXIMUM_DEPENDENCY_EDGES_PER_ANALYSIS=5000
# Interactive default. Use mock only when deterministic offline behavior is explicitly required.
DEVGUIDE_AI_PROVIDER=claude
DEVGUIDE_CLAUDE_MODEL=claude-sonnet-4-5
# Required only when DEVGUIDE_AI_PROVIDER=claude. Never commit or log a real value.
DEVGUIDE_ANTHROPIC_API_KEY=
DEVGUIDE_AI_REQUEST_TIMEOUT_SECONDS=30
DEVGUIDE_AI_MAXIMUM_OUTPUT_TOKENS=1024
DEVGUIDE_AI_MAXIMUM_EVIDENCE_ITEMS=10
DEVGUIDE_AI_MAXIMUM_EVIDENCE_CHARACTERS=30000
DEVGUIDE_STRUCTURE_EVIDENCE_FILE_LIMIT=8
DEVGUIDE_STRUCTURE_EVIDENCE_EDGE_LIMIT=12
DEVGUIDE_STRUCTURE_EVIDENCE_DIRECTORY_LIMIT=8
DEVGUIDE_MAXIMUM_UNUSED_CANDIDATES=100
DEVGUIDE_MAXIMUM_DUPLICATE_GROUPS=50
DEVGUIDE_MAXIMUM_DUPLICATE_MEMBERS=8
DEVGUIDE_MINIMUM_DUPLICATE_LINES=5
DEVGUIDE_MINIMUM_DUPLICATE_TOKENS=20
DEVGUIDE_AI_RETRY_COUNT=2
DEVGUIDE_AI_TEMPERATURE=0

# DevGuide AI web local-development configuration
VITE_DEVGUIDE_API_URL=http://localhost:8000
