# DevGuide AI API local-development configuration (safe examples only)
DEVGUIDE_APP_VERSION=0.1.0
DEVGUIDE_ENVIRONMENT=local
DEVGUIDE_LOG_LEVEL=INFO
DEVGUIDE_DATABASE_URL=postgresql+asyncpg://devguide:devguide@localhost:5432/devguide
DEVGUIDE_DATABASE_POOL_SIZE=5
DEVGUIDE_DATABASE_POOL_TIMEOUT_SECONDS=5
DEVGUIDE_ANALYSIS_PIPELINE_VERSION=1
DEVGUIDE_CLONE_TIMEOUT_SECONDS=60
DEVGUIDE_MAXIMUM_REPOSITORY_SIZE_MB=100
DEVGUIDE_MAXIMUM_REPOSITORY_FILE_COUNT=20000
DEVGUIDE_MAXIMUM_INDIVIDUAL_FILE_SIZE_MB=5
DEVGUIDE_TEMPORARY_WORKSPACE_ROOT=C:/tmp/devguide-workspaces
DEVGUIDE_GIT_EXECUTABLE=git
DEVGUIDE_CLONE_DEPTH=1
