# Copy to .env.production, restrict permissions, and replace every CHANGE_ME value.
POSTGRES_DB=devguide
POSTGRES_USER=devguide
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

DEVGUIDE_ENVIRONMENT=production
DEVGUIDE_LOG_LEVEL=INFO
DEVGUIDE_DATABASE_URL=postgresql+asyncpg://devguide:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/devguide
DEVGUIDE_REDIS_URL=redis://redis:6379/0
DEVGUIDE_CORS_ALLOWED_ORIGINS=["https://YOUR_DOMAIN"]
DEVGUIDE_AUTH_COOKIE_SECURE=true

# Use "mock" only when deterministic offline behavior is explicitly intended.
DEVGUIDE_AI_PROVIDER=claude
DEVGUIDE_ANTHROPIC_API_KEY=
DEVGUIDE_CLAUDE_MODEL=claude-sonnet-4-5

# Optional deployment settings.
DEVGUIDE_HTTP_PORT=80
DEVGUIDE_IMAGE_TAG=production
